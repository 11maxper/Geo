{
    "swagger": "2.0",
    "info": {
        "description": "Документация API для геосервиса, предоставляющего функции поиска адресов и геокодирования.",
        "title": "Geoservise API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/",
    "paths": {
        "/address/geocode": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Принимает координаты (широту и долготу) и возвращает информацию о соответствующем адресе.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "address"
                ],
                "summary": "Геокодирование координат",
                "parameters": [
                    {
                        "description": "Координаты для геокодирования",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.RequestAddressGeocode"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный ответ с данными об адресе",
                        "schema": {
                            "$ref": "#/definitions/models.ResponseAddress"
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос"
                    },
                    "403": {
                        "description": "Недопустимый токен"
                    },
                    "500": {
                        "description": "Ошибка сервера"
                    }
                }
            }
        },
        "/address/search": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Выполняет поиск адресов по введённой строке, возвращает список найденных адресов с координатами.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "address"
                ],
                "summary": "Поиск адресов",
                "parameters": [
                    {
                        "description": "Запрос с текстом для поиска адреса",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.RequestAddressSearch"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный ответ с найденными адресами",
                        "schema": {
                            "$ref": "#/definitions/models.ResponseAddress"
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос"
                    },
                    "403": {
                        "description": "Недопустимый токен"
                    },
                    "500": {
                        "description": "Ошибка сервера"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "description": "Проверяет логин и пароль, возвращает JWT-токен для доступа к защищённым эндпоинтам.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Авторизация пользователя",
                "parameters": [
                    {
                        "description": "Имя пользователя и пароль",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.Credentials"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Пользователь не существует или пароль не совпадает"
                    },
                    "400": {
                        "description": "Некорректный запрос"
                    },
                    "500": {
                        "description": "Ошибка сервера"
                    }
                }
            }
        },
        "/register": {
            "post": {
                "description": "Создаёт нового пользователя с указанными логином и паролем.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Регистрация нового пользователя",
                "parameters": [
                    {
                        "description": "Данные пользователя",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.Credentials"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Пользователь успешно зарегистрирован"
                    },
                    "400": {
                        "description": "Некорректный запрос или пользователь уже существует"
                    },
                    "500": {
                        "description": "Ошибка сервера"
                    }
                }
            }
        }
    },
    "definitions": {
        "models.Address": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "example": "Москва"
                },
                "house": {
                    "type": "string",
                    "example": "7"
                },
                "lat": {
                    "type": "string",
                    "example": "55.7579795"
                },
                "lon": {
                    "type": "string",
                    "example": "37.611263"
                },
                "street": {
                    "type": "string",
                    "example": "Тверская"
                }
            }
        },
        "models.Credentials": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "password123"
                },
                "username": {
                    "type": "string",
                    "example": "user1"
                }
            }
        },
        "models.RequestAddressGeocode": {
            "type": "object",
            "properties": {
                "lat": {
                    "type": "string",
                    "example": "55.7579795"
                },
                "lng": {
                    "type": "string",
                    "example": "37.611263"
                }
            }
        },
        "models.RequestAddressSearch": {
            "type": "object",
            "properties": {
                "query": {
                    "type": "string",
                    "example": "Москва, Тверская 7"
                }
            }
        },
        "models.ResponseAddress": {
            "type": "object",
            "properties": {
                "addresses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Address"
                    }
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Введите токен в формате: **Bearer {your_jwt_token}**",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}