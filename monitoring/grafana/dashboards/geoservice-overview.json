{
  "uid": "geoservice-overview",
  "title": "geoservice - overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },

  "templating": {
    "list": [
      {
        "type": "query",
        "name": "job",
        "label": "job",
        "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
        "query": { "query": "label_values(http_requests_total, job)", "refId": "job" },
        "refresh": 2
      },
      {
        "type": "query",
        "name": "instance",
        "label": "instance",
        "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
        "query": { "query": "label_values(http_requests_total{job=\"$job\"}, instance)", "refId": "instance" },
        "refresh": 2
      },
      {
        "type": "query",
        "name": "endpoint",
        "label": "endpoint",
        "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
        "query": { "query": "label_values(http_requests_total{job=\"$job\", instance=\"$instance\"}, endpoint)", "refId": "endpoint" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },

  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS total (without /metrics)",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"$job\",instance=\"$instance\",endpoint!=\"/metrics\"}[1m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx errors/sec",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"$job\",instance=\"$instance\",endpoint!=\"/metrics\",status_code=~\"5..\"}[2m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP p95 (ms) filtered by endpoint",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"$job\",instance=\"$instance\",endpoint=~\"$endpoint\",endpoint!=\"/metrics\"}[5m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "External API p95 by method (ms)",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(api_operation_duration_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache p95 by method (ms)",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "x": 8, "y": 7, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(cache_operation_duration_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB p95 by method (ms)",
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS" },
      "gridPos": { "x": 16, "y": 7, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(db_operation_duration_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    }
  ]
}
